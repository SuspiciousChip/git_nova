# Optional for public repositories; increases GitHub API rate limits.
# Use a token with only public repository read access. Never use NEXT_PUBLIC_.
GITHUB_TOKEN=your_github_token
# Required for AI features. Select a Gemini or Gemma model available to your API key.
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_API_KEY=your_gemini_api_key
# Reserved for optional local AI mode.
OLLAMA_BASE_URL=http://127.0.0.1:11434
