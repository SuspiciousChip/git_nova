# Optional for public repositories; increases GitHub API rate limits.
# Use a token with only public repository read access. Never use NEXT_PUBLIC_.
GITHUB_TOKEN=your_github_token
# AI provider: gemini (default) or ollama (Ollama Cloud).
AI_PROVIDER=gemini
# Required when AI_PROVIDER=gemini.
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_API_KEY=your_gemini_api_key
# Required when AI_PROVIDER=ollama. Use a model available to your Ollama Cloud account.
OLLAMA_API_KEY=your_ollama_api_key
OLLAMA_MODEL=your_cloud_model_name
# GitHub OAuth app settings for /login. Keep the client secret server-side.
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
AUTH_SECRET=replace_with_a_long_random_session_secret
